    <string name="as_access_allowed_desc">"செயல்தவிர்க்க அட்டை மூலம் மாற்றங்கள் உடனடியாகப் பொருந்தும். ஆப்ஸ் லாக் போன்ற உணர்திறன் உள்ளவர்கள் இன்னும் கேட்கிறார்கள்."</string>
    <string name="as_picker_detail">"அமைப்பை ஆன் அல்லது ஆஃப் செய்ய, ஸ்லைடரை நகர்த்த அல்லது வண்ணத் தட்டுகளை உருவாக்க Chat அல்லது Code இல் கேளுங்கள். உணர்திறன் அமைப்புகள் எப்போதும் முதலில் கேட்கும், மேலும் API விசைகள் அணுக முடியாத நிலையில் இருக்கும்."</string>
