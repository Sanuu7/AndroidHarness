    <string name="settings_agent_live_updates">"நேரடி நடவடிக்கைகள்"</string>
    <string name="settings_agent_live_updates_subtitle">"தற்போதைய ஏஜென்ட் இயக்கத்தை நிலைப் பட்டியில், பூட்டுத் திரையில் மற்றும் உங்கள் சாதனத்தின் லைவ் ஆக்டிவிட்டி பகுதியில் தெரியும்படி வைக்கவும்."</string>
    <string name="settings_agent_live_updates_device">"%1$s · %2$s"</string>
    <string name="settings_agent_live_updates_usage">"ஏஜென்ட் உண்மையில் வேலை செய்யும் போது மட்டுமே கார்டு தோன்றும், மேலும் ஏஜென்ட்டுக்கு நீங்கள் தேவைப்படும்போது ஒப்புதல்/மறுக்கவும் காட்டுகிறது. செயலற்ற பின்னணி சேவைகள் ஒருபோதும் விளம்பரப்படுத்தப்படுவதில்லை."</string>
    <string name="settings_agent_live_updates_open">"அறிவிப்பு அமைப்புகளைத் திறக்கவும்"</string>
    <string name="settings_live_state_ready">"இந்தச் சாதனத்தில் AndroidHarnessக்கான நேரடி புதுப்பிப்புகள் அனுமதிக்கப்படுகின்றன."</string>
    <string name="settings_live_state_blocked">"Android இன்னும் AndroidHarness க்கான நேரடி புதுப்பிப்புகளை அனுமதிக்கவில்லை. கீழே உள்ள கணினி அமைப்புகளில் அவற்றை இயக்கவும்."</string>
    <string name="settings_live_state_unsupported">"நேரடி புதுப்பிப்புகளுக்கு Android 16 அல்லது புதியது தேவை."</string>
    <string name="settings_live_vendor_samsung">"Samsung One UI"</string>
    <string name="settings_live_steps_samsung">"Samsung இவற்றை Now Bar அட்டைகளாகக் காட்டுகிறது. கார்டு அறிவிப்பு நிழலில் மட்டுமே தோன்றினால், டெவலப்பர் விருப்பங்களைத் திறந்து, \"எல்லா பயன்பாடுகளுக்கும் நேரலை அறிவிப்புகள்\" என்பதை இயக்கவும், பின்னர் AndroidHarness ஐ மீண்டும் திறக்கவும்."</string>
    <string name="settings_live_vendor_google">"பிக்சல் / பங்கு Android"</string>
    <string name="settings_live_steps_google">"பிக்சல் மற்றும் ஸ்டாக் Android 16 இவற்றை லாக் ஸ்கிரீன் மற்றும் ஸ்டேட்டஸ் பாரில் லைவ் அப்டேட்களாகக் காட்டுகின்றன. அறிவிப்பு அமைப்புகளில் AndroidHarness க்கான நேரடி புதுப்பிப்புகளை அனுமதிக்கவும்."</string>
    <string name="settings_live_vendor_xiaomi">"Xiaomi HyperOS"</string>
    <string name="settings_live_steps_xiaomi">"HyperOS இன்னும் மூன்றாம் தரப்பு நேரடி புதுப்பிப்புகளை வெளியிடாமல் இருக்கலாம். AndroidHarness அறிவிப்புகள் இன்னும் செயல்படுகின்றன; HyperOS ஆதரவைச் சேர்த்தால், இந்த அட்டை தானாகவே தோன்றும்."</string>
    <string name="settings_live_vendor_color_os">"OnePlus / OPPO / realme"</string>
    <string name="settings_live_steps_color_os">"ColorOS மற்றும் OxygenOS இந்த நேரடி விழிப்பூட்டல்களை அழைக்கின்றன. அமைப்புகள் → அறிவிப்புகள் &amp; நிலைப் பட்டியில் AndroidHarness க்கான நேரடி விழிப்பூட்டல்களை அனுமதித்து, பின்னர் இயக்கத்தைத் தொடங்கவும்."</string>
    <string name="settings_live_vendor_origin_os">"vivo / iQOO"</string>
    <string name="settings_live_steps_origin_os">"OriginOS இன்னும் மூன்றாம் தரப்பு நேரடி புதுப்பிப்புகளை வெளியிடாமல் இருக்கலாம். நடந்துகொண்டிருக்கும் அறிவிப்பு இன்னும் வேலை செய்கிறது, ஒருமுறை இந்த கார்டு தானாகவே தோன்றும்."</string>
    <string name="settings_live_vendor_magic_os">"ஹானர் மேஜிகோஸ்"</string>
    <string name="settings_live_steps_magic_os">"MagicOS இன்னும் மூன்றாம் தரப்பு நேரடி புதுப்பிப்புகளை வெளியிடாமல் இருக்கலாம். நடந்துகொண்டிருக்கும் அறிவிப்பு இன்னும் வேலை செய்கிறது, ஒருமுறை இந்த கார்டு தானாகவே தோன்றும்."</string>
    <string name="settings_live_vendor_near_stock">"அருகில்-பங்கு Android"</string>
