<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="context_window_button">சூழல் பயன்பாடு</string>
    <string name="context_window_remaining">%1$s டோக்கன்கள் மீதம்</string>
    <string name="context_window_used">%1$s / %2$s டோக்கன்கள் பயன்படுத்தப்பட்டது</string>
    <string name="context_window_estimate">தற்போதைய சூழலின் மதிப்பீடு. இயக்கங்களின் போது புதுப்பிக்கப்படும்; அனுப்பப்படாத உரை சேர்க்கப்படாது.</string>
    <string name="context_window_last_request">சமீபத்திய கோரிக்கையிலிருந்து; அனுப்பப்படாத உரை சேர்க்கப்படாது.</string>
    <string name="context_window_pending">முதல் கோரிக்கைக்குப் பிறகு சூழல் பயன்பாடு தோன்றும்.</string>
    <string name="context_window_summarized">முந்தைய செய்திகள் சுருக்கப்பட்டுள்ளன. முழு வரலாறும் இந்த அரட்டையில் இருக்கும்.</string>
    <string name="context_window_compact">சுருக்கு</string>
    <string name="context_window_compact_help">முந்தைய செய்திகளைச் சுருக்க /compact அனுப்பப்படும்.</string>
    <string name="context_window_busy">சுருக்குவதற்கு முன் தற்போதைய பணியை நிறுத்தவும்.</string>
</resources>
