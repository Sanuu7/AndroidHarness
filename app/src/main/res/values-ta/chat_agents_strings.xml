    <string name="chat_agents_regular_desc">"உங்கள் வழக்கமான Chat அமைப்புகள் மற்றும் தனிப்பட்ட வழிமுறைகள்"</string>
    <string name="chat_agents_empty">"உங்கள் ஒவ்வொரு பக்கத்திற்கும் ஒரு உதவியாளர்"</string>
    <string name="chat_agents_empty_desc">"ஒரு ஆய்வுக் கூட்டாளியாகவோ, எழுத்துத் துணையாகவோ அல்லது ஆராய்ச்சியாளரையோ உருவாக்குங்கள். ஒவ்வொருவருக்கும் ஒரு நோக்கத்தைக் கொடுத்து உரையாடலைத் தொடங்குங்கள்."</string>
    <string name="chat_agents_count">"%1$d சேமிக்கப்பட்டது · புதிய உரையாடலுக்குத் தயாராக உள்ளது"</string>
