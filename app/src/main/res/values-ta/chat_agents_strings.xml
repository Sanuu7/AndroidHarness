    <string name="chat_agents_history">"மற்ற Chat மற்றும் Code வரலாற்றைப் பயன்படுத்தவும்"</string>
    <string name="chat_agents_history_desc">"ஆஃப்: இந்த ஏஜென்ட்டின் உரையாடல்களை மட்டும் தேடவும். ஆன்: வழக்கமான Chat மற்றும் Code வரலாற்றையும் அனுமதிக்கவும். மற்ற முகவர்கள் தனித்தனியாக இருக்கிறார்கள்."</string>
    <string name="chat_agents_skills">"திறன்கள்"</string>
    <string name="chat_agents_skills_desc">"6 அறிவுறுத்தல் அடிப்படையிலான திறன்களைத் தேர்வு செய்யவும். ஸ்கிரிப்டுகள் மற்றும் துணை கோப்புகள் Chat இல் இல்லை. தேர்ந்தெடுக்கப்பட்ட வழிமுறைகள் முகவருடன் சேமிக்கப்படும்."</string>
    <string name="chat_agents_skills_choose">"திறன்களைத் தேர்ந்தெடுங்கள்"</string>
    <string name="chat_agents_skills_empty">"செயல்படுத்தப்பட்ட திறன்கள் இல்லை. அவற்றை அமைப்புகள் → கோடிங் → திறன்களில் சேர்க்கவும்."</string>
    <string name="chat_agents_search_skills">"தேடல் திறன்"</string>
    <string name="chat_agents_skill_large">"இந்த திறன் Chat க்கு மிகவும் பெரியது. குறுகிய அறிவுறுத்தல் அடிப்படையிலான திறமையைப் பயன்படுத்தவும்."</string>
