<resources>
    <string name="settings_page_rumble_title">"AH Rumble"</string>
    <string name="settings_page_rumble_desc">"அரட்டைகள் யோசித்து, கருவிகளை அழைக்கவும் மற்றும் முடிக்கவும் ஹாப்டிக் பருப்புகள்"</string>
    <string name="rumble_title">"AH Rumble"</string>
    <string name="rumble_desc">"சிந்தனை, ஒரு கருவி அழைப்பு, பதில் எழுதுதல் அல்லது முடித்தல் போன்ற ஒரு புதிய படிக்கு உரையாடல் நகரும் போது ஒரு துடிப்பை உணருங்கள்."</string>
    <string name="rumble_where_title">"அது எங்கே முழங்குகிறது"</string>
    <string name="rumble_in_chat">"Chat"</string>
    <string name="rumble_in_chat_desc">"Chat திருப்பங்களின் போது துடிப்பு."</string>
    <string name="rumble_in_code">"Code"</string>
    <string name="rumble_in_code_desc">"Code என துடிப்பு கருவிகளை இயக்குகிறது."</string>
    <string name="rumble_strength">"வலிமை"</string>
    <string name="rumble_feel">"உணருங்கள்"</string>
    <string name="rumble_feel_crisp">"மிருதுவான"</string>
    <string name="rumble_feel_smooth">"மென்மையானது"</string>
    <string name="rumble_try">"உணருங்கள்"</string>
    <string name="rumble_hint">"உங்கள் மொபைலின் தொடு அதிர்வு அமைப்பைப் பின்பற்றுகிறது."</string>
    <string name="rumble_engine_title">"ஹாப்டிக் இயந்திரம்"</string>
    <string name="rumble_engine_status_system">"இந்த ஃபோன் Android இன் உள்ளமைக்கப்பட்ட ஹாப்டிக் விளைவுகளை ஆதரிக்கிறது."</string>
    <string name="rumble_engine_status_custom">"இந்த ஃபோன் உள்ளமைக்கப்பட்ட ஹாப்டிக் விளைவுகளை ஆதரிக்காது, எனவே தனிப்பயன் அலைவடிவம் பயன்படுத்தப்படுகிறது."</string>
    <string name="rumble_engine_auto">"தானியங்கி"</string>
    <string name="rumble_engine_auto_desc">"தொலைபேசி ஆதரிக்கும் போது உள்ளமைக்கப்பட்ட விளைவுகளைப் பயன்படுத்தவும், இல்லையெனில் தனிப்பயன் அலைவடிவம்."</string>
    <string name="rumble_engine_system">"உள்ளமைக்கப்பட்ட விளைவுகள்"</string>
    <string name="rumble_engine_system_desc">"Android இன் சொந்த டியூன் செய்யப்பட்ட ஹாப்டிக்ஸ் (Android 11 அல்லது அதற்குப் பிறகு). ஆதரிக்கப்படாவிட்டால், வழக்கத்திற்குத் திரும்பும்."</string>
    <string name="rumble_engine_custom">"விருப்ப அலைவடிவம்"</string>
    <string name="rumble_engine_custom_desc">"அதிர்வு மோட்டார் கொண்ட எந்த ஃபோனிலும் வலிமை மற்றும் உணர்வால் வடிவமைக்கப்பட்ட நமது சொந்த துடிப்பு."</string>
    <string name="rumble_events_title">"நிகழ்வுகள்"</string>
    <string name="rumble_events_desc">"சீரற்ற வடிவங்களின் தொகுப்பில் தொடங்குகிறது. மற்றொன்றுக்கு கலக்கவும் அல்லது ஒவ்வொரு கணத்திற்கும் பேட்டர்ன் மற்றும் லெவலை தேர்வு செய்யவும்."</string>
    <string name="rumble_shuffle">"கலக்கு"</string>
    <string name="rumble_advanced_title">"மேம்பட்டது"</string>
    <string name="rumble_advanced_desc">"வலிமை, உணர்வு, இயந்திரம், நிகழ்வுகள் மற்றும் சிறந்த ட்யூனிங். இயல்புநிலைகள் ஏற்கனவே டியூன் செய்யப்பட்டுள்ளன."</string>
    <string name="rumble_flow_title">"எழுதும் போது ரம்பிள்"</string>
    <string name="rumble_flow_desc">"Chat பதில் வரும் வரை ஒரு மென்மையான, அமைதியான ரம்பிள். பணக்கார காட்சிகள் அவற்றின் மெதுவான ரம்பையைப் பெறுகின்றன. Chat மட்டும்."</string>
    <string name="rumble_flow_status_system">"உங்கள் மொபைலின் மேம்பட்ட ஹாப்டிக்ஸைப் பயன்படுத்துதல்."</string>
    <string name="rumble_flow_status_custom">"இந்த மொபைலில் மேம்பட்ட ஹாப்டிக்ஸ் இல்லை, எனவே AH Rumble இன் சொந்த பருப்பு வகைகள் பயன்படுத்தப்படுகின்றன."</string>
    <string name="rumble_flow_try">"ஓட்டத்தை உணருங்கள்"</string>
    <string name="rumble_cue_think">"யோசிக்கிறேன்"</string>
    <string name="rumble_cue_think_desc">"மாதிாி மீண்டும் யோசிக்கிறான்."</string>
    <string name="rumble_cue_tool_start">"கருவி தொடங்குகிறது"</string>
    <string name="rumble_cue_tool_start_desc">"ஒரு தேடல் அல்லது படிக்கப்பட்ட படம் போன்ற கருவி அழைப்பு தொடங்குகிறது."</string>
    <string name="rumble_cue_tool_done">"கருவி முடிந்தது"</string>
