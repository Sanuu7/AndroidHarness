    <string name="resume_prompt_title">மீண்டும் தொடங்கும் ப்ராம்ப்ட்</string>
    <string name="resume_prompt_group">மீட்பு</string>
    <string name="resume_prompt_app_summary">இடைநிறுத்தப்பட்ட அல்லது தடைபட்ட பணி மீண்டும் தொடங்கும்போது தானியங்கி தொடர்வு உட்பட மாதிரிக்கு அனுப்பப்படும். அரட்டைகள் இதை மேலெழுதலாம்.</string>
    <string name="resume_prompt_app_detail">மீண்டும் தொடங்கும் ஒவ்வொரு Code மற்றும் Chat பணிக்கும் இது இயல்புநிலை. உள்ளமைந்த ப்ராம்ப்ட்டைப் பயன்படுத்த காலியாக விடவும்.</string>
    <string name="resume_prompt_chat_detail">இந்த அரட்டை கைமுறையாக அல்லது தானாக மீண்டும் தொடங்கும்போது மட்டுமே பயன்படும். அமைப்புகளை மீண்டும் பின்பற்ற செயலி இயல்புநிலையைப் பயன்படுத்தவும்.</string>
