<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_welcome_title">"AndroidHarness க்கு வரவேற்கிறோம்"</string>
    <string name="setup_welcome_body">"உங்கள் கோடிங் முகவர், உங்கள் மொபைலிலேயே. அமைப்போம்."</string>
    <string name="setup_start_fresh">"புதிதாகத் தொடங்கு"</string>
    <string name="setup_start_fresh_body">"முற்றிலும் புதிய AndroidHarness அமைக்கவும்"</string>
    <string name="setup_restore">"AndroidHarness மீட்டமை"</string>
    <string name="setup_restore_body">"காப்புப்பிரதிக் கோப்பிலிருந்து உங்கள் அரட்டைகளையும் அமைப்புகளையும் திரும்பக் கொண்டு வாருங்கள்"</string>

    <string name="setup_storage_title">"கோப்பு அணுகலை அனுமதிக்கவும்"</string>
    <string name="setup_storage_body">"விருப்பமானது. இது இல்லாமல் AndroidHarness அதன் சொந்த கோப்புறையில் வேலை செய்து, ஒரு பணிக்கு உங்கள் கோப்புகள் தேவைப்படும்போது கேட்கும்."</string>
    <string name="setup_storage_all_files">"அனைத்து கோப்புகளுக்கும் அணுகல்"</string>
    <string name="setup_storage_all_files_body">"டெர்மினலும் கோப்பு கருவிகளும் எதிர்பார்ப்பது போல எந்தக் கோப்புறையையும் படித்து திருத்துங்கள். கோடிங்கிற்கு சிறந்தது."</string>
    <string name="setup_storage_legacy">"சேமிப்பக அனுமதி"</string>
    <string name="setup_storage_legacy_body">"உங்கள் மொபைலின் கோப்புகளையும் கோப்புறைகளையும் படித்து திருத்துங்கள்."</string>
    <string name="setup_storage_media">"படங்கள் மற்றும் மீடியா"</string>
    <string name="setup_storage_read">"சேமிப்பகத்தைப் படி"</string>
    <string name="setup_storage_media_body">"உங்கள் படங்கள், வீடியோக்கள், இசையைப் படியுங்கள்."</string>
    <string name="setup_storage_read_body">"படங்கள், வீடியோக்கள், இசை மற்றும் பிற பகிரப்பட்ட கோப்புகளைப் படியுங்கள்."</string>
    <string name="setup_storage_unavailable">"இந்த மொபைலில் அனைத்து கோப்புகளுக்கும் அணுகல் அமைப்பு இல்லை, எனவே திட்டங்கள் செயலியின் சொந்த கோப்புறையில் இருக்கும்."</string>
    <string name="setup_storage_skip">"இப்போது தவிர்"</string>
    <string name="setup_storage_granted">"கோப்பு அணுகல் இயக்கத்தில் உள்ளது"</string>
    <string name="setup_allow_access">"அணுகலை அனுமதிக்கவும்"</string>

    <string name="setup_restore_title">"உங்கள் தரவை மீட்டெடுக்கவும்"</string>
    <string name="setup_restore_subtitle">"உங்கள் பழைய மொபைலிலிருந்து காப்புப்பிரதிக் கோப்புகளைத் தேர்ந்தெடுக்கவும். ஒன்றை, இரண்டையும் அல்லது எதையும் மீட்டெடுக்கவும்."</string>
    <string name="setup_restore_chats">"அரட்டைகள்"</string>
    <string name="setup_restore_chats_body">"உங்கள் அரட்டைகள், படங்கள், பயன்பாட்டு புள்ளிவிவரங்கள், நினைவுகள், துணுக்குகள் கொண்ட .harnessbackup கோப்பு"</string>
    <string name="setup_restore_settings">"அமைப்புகள் மற்றும் வழங்குநர்கள்"</string>
    <string name="setup_restore_settings_body">"உங்கள் வழங்குநர்கள், API விசைகள், விருப்பங்கள் கொண்ட கடவுச்சொல் பாதுகாக்கப்பட்ட .hbackup கோப்பு"</string>
    <string name="setup_restore_choose">"கோப்பைத் தேர்ந்தெடு"</string>
    <string name="setup_restore_another">"மற்றொன்றை மீட்டெடு"</string>
    <string name="setup_restore_settings_done">"உங்கள் அமைப்புகள் திரும்பி வந்தன"</string>

