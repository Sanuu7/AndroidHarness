    <string name="nine_router_auto_start_body">"AndroidHarness திறக்கும் போது நிறுவப்பட்ட திசைவியைத் தொடங்கவும்."</string>
    <string name="nine_router_add_provider">"வழங்குநர்களுக்கு 9Router ஐச் சேர்க்கவும்"</string>
    <string name="nine_router_refresh_provider">"9Router வழங்குநரைப் புதுப்பிக்கவும்"</string>
    <string name="nine_router_provider_body">"தேவைப்பட்டால் 9Router ஐத் தொடங்கி அதன் உள்ளூர் இறுதிப்புள்ளி மற்றும் API விசையை தானாகவே நிரப்புகிறது. இணைக்கப்பட்ட மாதிரிகள் Chat மற்றும் Code மாடல் பிக்கர்களில் கிடைக்கும்."</string>
    <string name="nine_router_remove_provider">"வழங்குநர்களிடமிருந்து அகற்று"</string>
    <string name="nine_router_remove_provider_body">"AndroidHarness இலிருந்து 9Router இணைப்புகளை அகற்றவும். திசைவி மற்றும் அதன் கணக்குகள் நிறுவப்பட்ட நிலையில் இருக்கும்."</string>
    <string name="nine_router_uninstall">"9Router ஐ நிறுவல் நீக்கவும்"</string>
    <string name="nine_router_uninstall_title">"9Router ஐ முழுமையாக நிறுவல் நீக்கவா?"</string>
    <string name="nine_router_uninstall_body">"9Router ஐ நிறுத்தி, அதன் நிறுவல், சேமித்த கணக்குகள், திசைவி API விசைகள், உள்ளமைவு, கேச், ஆட்டோ-ஸ்டார்ட் விருப்பம் மற்றும் பயன்பாட்டு வழங்குநர் இணைப்புகளை நீக்குகிறது. இதை செயல்தவிர்க்க முடியாது. பகிரப்பட்ட Linux கருவித்தொகுப்பு மற்ற அம்சங்களுக்குக் கிடைக்கும்."</string>
