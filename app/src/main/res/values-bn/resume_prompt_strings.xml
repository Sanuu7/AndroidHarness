    <string name="resume_prompt_app_summary">বিরত বা বাধাগ্রস্ত কাজ পুনরায় চালু হলে মডেলকে পাঠানো হয়, স্বয়ংক্রিয় পুনরারম্ভসহ। চ্যাটগুলি এটি অগ্রাহ্য করতে পারে।</string>
    <string name="resume_prompt_app_detail">পুনরায় চালু হওয়া প্রতিটি কোড ও চ্যাট কাজের জন্য এটি ডিফল্ট। অন্তর্নির্মিত প্রম্পট ব্যবহার করতে খালি রাখুন।</string>
    <string name="resume_prompt_chat_detail">কেবল এই চ্যাট পুনরায় চালু হলে ব্যবহার হয়, হাতে বা স্বয়ংক্রিয়ভাবে। আবার সেটিংস অনুসরণ করতে অ্যাপ ডিফল্ট ব্যবহার করুন।</string>
