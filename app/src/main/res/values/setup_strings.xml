<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_welcome_title">Welcome to AndroidHarness</string>
    <string name="setup_welcome_body">Your coding agent, right on your phone. Let\'s get you set up.</string>
    <string name="setup_start_fresh">Start fresh</string>
    <string name="setup_start_fresh_body">Set up a brand new AndroidHarness</string>
    <string name="setup_restore">Restore AndroidHarness</string>
    <string name="setup_restore_body">Bring back your chats and settings from a backup file</string>

    <string name="setup_storage_title">Allow file access</string>
    <string name="setup_storage_body">Optional. Without it, AndroidHarness works in its own folder and asks when a task needs your files.</string>
    <string name="setup_storage_all_files">All files access</string>
    <string name="setup_storage_all_files_body">Read and edit any folder, the way the terminal and file tools expect. Best for coding.</string>
    <string name="setup_storage_legacy">Storage permission</string>
    <string name="setup_storage_legacy_body">Read and edit the files and folders on your phone.</string>
    <string name="setup_storage_media">Photos &amp; media</string>
    <string name="setup_storage_read">Read storage</string>
    <string name="setup_storage_media_body">Read your photos, videos and music.</string>
    <string name="setup_storage_read_body">Read photos, videos, music and other shared files.</string>
    <string name="setup_storage_unavailable">This phone has no All files access setting, so projects live in the app\'s own folder.</string>
    <string name="setup_storage_skip">Skip for now</string>
    <string name="setup_storage_granted">File access is on</string>
    <string name="setup_allow_access">Allow access</string>

    <string name="setup_restore_title">Restore your stuff</string>
    <string name="setup_restore_subtitle">Pick the backup files from your old phone. Restore one, both or neither.</string>
    <string name="setup_restore_chats">Chats</string>
    <string name="setup_restore_chats_body">A .harnessbackup file with your chats, images, usage stats, memories and snippets</string>
    <string name="setup_restore_settings">Settings &amp; providers</string>
    <string name="setup_restore_settings_body">A password-protected .hbackup file with your providers, API keys and preferences</string>
    <string name="setup_restore_choose">Choose file</string>
    <string name="setup_restore_another">Restore another</string>
    <string name="setup_restore_settings_done">Your settings are back</string>

    <string name="setup_powerups_title">Power-ups</string>
    <string name="setup_powerups_subtitle">All optional. You can turn any of these on later in Settings.</string>

    <string name="setup_ready_title">You\'re all set</string>
    <string name="setup_ready_body">Here is what\'s ready to go.</string>
    <string name="setup_ready_storage">File access</string>
    <string name="setup_ready_notifications">Notifications</string>
    <string name="setup_ready_shizuku">Shizuku</string>
    <string name="setup_ready_linux">Linux tools</string>
    <string name="setup_ready_battery">Background runs</string>
    <string name="setup_ready_media">Photos &amp; media</string>
    <string name="setup_ready_settings">Settings restored</string>

    <string name="setup_continue">Continue</string>
