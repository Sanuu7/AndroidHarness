<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="trust_dialog_title">"이 작업 공간의 도구를 허용할까요?"</string>
    <string name="trust_dialog_body">"이 작업 공간에는 기기에서 명령을 실행하고 네트워크에 접속할 수 있는 서버와 플러그인이 있습니다. 신뢰하는 것만 허용하세요."</string>
    <string name="trust_dialog_unticked">"체크하지 않은 항목은 실행되지 않으며 변경되기 전까지 다시 묻지 않습니다. 이 설정은 구성 설정에서 바꿀 수 있습니다."</string>
    <string name="trust_dialog_trust_all">"이 작업 공간의 모든 항목 신뢰"</string>
    <string name="trust_dialog_trust_all_hint">"나중에 추가되는 항목(예: git pull 후)은 묻지 않고 실행됩니다. 본인 프로젝트의 예약 작업에 편리합니다."</string>
    <string name="trust_continue">"계속"</string>
    <string name="trust_not_now">"지금은 안 함"</string>
    <string name="trust_kind_server">"MCP 서버"</string>
    <string name="trust_kind_plugin">"플러그인"</string>
    <string name="trust_kind_language_server">"언어 서버"</string>
    <string name="trust_kind_bin">"플러그인 명령 폴더"</string>
    <string name="trust_state_new">"새 항목"</string>
    <string name="trust_state_changed">"마지막 응답 이후 변경됨"</string>
    <string name="trust_state_approved">"허용됨"</string>
    <string name="trust_state_declined">"허용 안 됨"</string>
    <string name="trust_state_blocked">"이 작업 공간 설정으로 차단됨"</string>
    <string name="trust_panel_title">"프로젝트 도구"</string>
    <string name="trust_panel_hint">"서버와 플러그인은 명령을 실행하고 서비스에 접속할 수 있습니다. 지침이나 문서 편집은 다시 묻지 않으며 실제로 실행되는 내용의 변경만 묻습니다."</string>
    <string name="trust_mode_title">"실행 허용 시점"</string>
    <string name="trust_mode_ask_changes">"새 도구와 변경된 도구 모두 묻기"</string>
    <string name="trust_mode_ask_changes_hint">"가장 안전합니다. 허용된 서버나 플러그인을 편집하면 다시 묻습니다."</string>
    <string name="trust_mode_ask_new">"새 도구만 묻기"</string>
    <string name="trust_mode_ask_new_hint">"허용된 도구는 변경 후에도 계속 실행됩니다. 직접 편집하는 프로젝트에 좋습니다."</string>
    <string name="trust_mode_trust_all">"모두 신뢰"</string>
    <string name="trust_mode_trust_all_hint">"아무것도 묻지 않습니다. 이 작업 공간이 추가하는 모든 항목이 git pull 후에도 즉시 실행됩니다."</string>
    <string name="trust_mode_block_all">"절대 실행 안 함"</string>
    <string name="trust_mode_block_all_hint">"이 작업 공간의 서버와 플러그인은 실행되지 않으며 아무것도 묻지 않습니다. 전역 서버는 계속 작동합니다."</string>
    <string name="trust_items_title">"서버와 플러그인"</string>
    <string name="trust_items_hint">"하나를 켜면 실행을 허용합니다. 끄면 응답이 기억되어 변경되기 전까지 다시 묻지 않습니다."</string>
    <string name="trust_items_mode_note">"위 설정이 지금 모든 항목에 적용됩니다. 묻기 모드로 돌아가면 여기의 응답이 다시 유효합니다."</string>
    <string name="trust_allow_all">"모두 허용"</string>
    <string name="trust_forget">"내 응답 잊기"</string>
    <string name="trust_changed_reload">"구성이 변경되었습니다. 허용하기 전에 다시 검토하세요."</string>
    <string name="trust_needs_approval">"프로젝트 도구에 승인이 필요합니다: %1$s. 이 채팅을 열어 허용하거나 구성 설정에서 이 작업 공간이 도구를 신뢰하는 방식을 선택하세요."</string>
</resources>
