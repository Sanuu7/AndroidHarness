    <string name="rumble_engine_system_desc">"Android की स्वयं की ट्यून की गई हैप्टिक्स (Android 11 या बाद की)। असमर्थित होने पर कस्टम पर वापस आ जाता है।"</string>
    <string name="rumble_engine_custom">"कस्टम तरंग"</string>
