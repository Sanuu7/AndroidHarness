    <string name="nine_router_auto_start_body">"AndroidHarness खुलने पर स्थापित राउटर को प्रारंभ करें।"</string>
    <string name="nine_router_add_provider">"प्रदाताओं में 9Router जोड़ें"</string>
    <string name="nine_router_refresh_provider">"9Router प्रदाता को ताज़ा करें"</string>
    <string name="nine_router_provider_body">"यदि आवश्यक हो तो 9Router प्रारंभ करता है और इसके स्थानीय समापन बिंदु और API कुंजी को स्वचालित रूप से भरता है। कनेक्टेड मॉडल Chat और Code मॉडल पिकर में उपलब्ध हो जाते हैं।"</string>
    <string name="nine_router_remove_provider">"प्रदाताओं से निकालें"</string>
    <string name="nine_router_remove_provider_body">"AndroidHarness से 9Router कनेक्शन हटाएँ। राउटर और उसके खाते इंस्टॉल रहेंगे."</string>
    <string name="nine_router_uninstall">"9Router को अनइंस्टॉल करें"</string>
    <string name="nine_router_uninstall_title">"9Router को पूरी तरह से अनइंस्टॉल करें?"</string>
    <string name="nine_router_uninstall_body">"9Router को रोकता है और इसकी स्थापना, सहेजे गए खाते, राउटर API कुंजी, कॉन्फ़िगरेशन, कैश, ऑटो-स्टार्ट प्राथमिकता और ऐप प्रदाता कनेक्शन हटा देता है। इसे असंपादित नहीं किया जा सकता है। साझा Linux टूलचेन अन्य सुविधाओं के लिए उपलब्ध रहता है।"</string>
