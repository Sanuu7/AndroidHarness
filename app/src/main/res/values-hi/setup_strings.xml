    <string name="setup_welcome_title">"AndroidHarness में आपका स्वागत है"</string>
    <string name="setup_welcome_body">"आपका कोडिंग एजेंट, सीधे आपके फ़ोन पर। चलिए इसे सेट करें।"</string>
    <string name="setup_start_fresh">"नई शुरुआत करें"</string>
    <string name="setup_start_fresh_body">"बिल्कुल नया AndroidHarness सेट करें"</string>
    <string name="setup_restore">"AndroidHarness पुनर्स्थापित करें"</string>
    <string name="setup_restore_body">"बैकअप फ़ाइल से अपनी चैट और सेटिंग्स वापस लाएँ"</string>

    <string name="setup_storage_title">"फ़ाइल पहुँच की अनुमति दें"</string>
    <string name="setup_storage_body">"वैकल्पिक। इसके बिना AndroidHarness अपने ही फ़ोल्डर में काम करता है और जब किसी काम को आपकी फ़ाइलें चाहिए हों तब पूछता है।"</string>
    <string name="setup_storage_all_files">"सभी फ़ाइलों तक पहुँच"</string>
    <string name="setup_storage_all_files_body">"किसी भी फ़ोल्डर को पढ़ें और संपादित करें, जैसा टर्मिनल और फ़ाइल टूल उम्मीद करते हैं। कोडिंग के लिए सबसे अच्छा।"</string>
    <string name="setup_storage_legacy">"भंडारण अनुमति"</string>
    <string name="setup_storage_legacy_body">"अपने फ़ोन की फ़ाइलें और फ़ोल्डर पढ़ें और संपादित करें।"</string>
    <string name="setup_storage_media">"फ़ोटो और मीडिया"</string>
    <string name="setup_storage_read">"भंडारण पढ़ें"</string>
    <string name="setup_storage_media_body">"अपनी फ़ोटो, वीडियो और संगीत पढ़ें।"</string>
    <string name="setup_storage_read_body">"फ़ोटो, वीडियो, संगीत और अन्य साझा फ़ाइलें पढ़ें।"</string>
    <string name="setup_storage_unavailable">"इस फ़ोन में सभी फ़ाइलों तक पहुँच की सेटिंग नहीं है, इसलिए प्रोजेक्ट ऐप के अपने फ़ोल्डर में रहते हैं।"</string>
    <string name="setup_storage_skip">"अभी छोड़ें"</string>
    <string name="setup_storage_granted">"फ़ाइल पहुँच चालू है"</string>
    <string name="setup_allow_access">"पहुँच की अनुमति दें"</string>

    <string name="setup_restore_title">"अपना डेटा पुनर्स्थापित करें"</string>
    <string name="setup_restore_subtitle">"अपने पुराने फ़ोन से बैकअप फ़ाइलें चुनें। एक, दोनों या कोई नहीं पुनर्स्थापित करें।"</string>
    <string name="setup_restore_chats">"चैट"</string>
    <string name="setup_restore_chats_body">"आपकी चैट, तस्वीरों, उपयोग आँकड़ों, यादों और स्निपेट वाली .harnessbackup फ़ाइल"</string>
    <string name="setup_restore_settings">"सेटिंग्स और प्रदाता"</string>
    <string name="setup_restore_settings_body">"आपके प्रदाताओं, API कुंजियों और प्राथमिकताओं वाली पासवर्ड-सुरक्षित .hbackup फ़ाइल"</string>
    <string name="setup_restore_choose">"फ़ाइल चुनें"</string>
