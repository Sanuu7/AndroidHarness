{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sanuu7/AndroidHarness/main/docs/harness.schema.json",
  "title": "AndroidHarness workspace configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "instructions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "glob": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "path"
            ]
          },
          "maxItems": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "skills": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "paths": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "enable": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "disable": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "auto_load": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plugins": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "paths": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "npm": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "enable": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "disable": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 1024
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "anyOf": [
                      {
                        "enum": [
                          "local",
                          "remote",
                          "stdio",
                          "http",
                          "sse"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "command": {
                    "anyOf": [
                      {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "maxItems": 1024,
                            "minItems": 1
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "args": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxItems": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "env": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "enabled": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^https?://"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "headers": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "permissions": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "shell": {
              "anyOf": [
                {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "edit": {
              "anyOf": [
                {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "delete": {
              "anyOf": [
                {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "network": {
              "anyOf": [
                {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "outside_workspace": {
              "anyOf": [
                {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "agents": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "instructions": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxItems": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tools": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": {
                          "type": "boolean"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "default_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "memory": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "topics_dir": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "auto_recall": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_core_lines": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
